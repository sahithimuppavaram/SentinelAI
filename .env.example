
# SentinelAI example configuration
# Copy to .env and replace placeholders locally.
# Never commit real credentials.

DATABASE_URL=postgresql://sentinel:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/sentinel_ai

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

SENTINEL_API_URL=http://127.0.0.1:8000

ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

CLAUDE_MODEL=claude-haiku-4-5
